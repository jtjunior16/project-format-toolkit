# .env.example: lists every environment variable this project uses.
# Copy to .env (or run: uv run --no-project python scripts/sync_env.py) and fill in real values.
# .env is gitignored and never committed. Claude never reads it.
# Secrets only. Non-secret parameters belong in config.yaml.

# >>> postgres
# Local Postgres (docker-compose.yml reads these)
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
# Example: postgresql+psycopg://<user>:<password>@localhost:5432/<db>
DATABASE_URL=
# <<< postgres
